generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN
  COMPANY_OWNER
  COMPANY_MANAGER
  USER
}

enum InviteType {
  COMPANY
  USER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum TokenOwnerType {
  TENANT
  INTERNAL
}

enum LedgerEntryType {
  CREDIT
  DEBIT
  REFUND
  ADJUSTMENT
  BONUS
  RECHARGE
}

enum ProviderAuthType {
  NONE
  API_KEY
  BEARER
  BASIC_AUTH
  CUSTOM
}

enum ProviderOperationType {
  BALANCE_CHECK
  RECHARGE
  CUSTOM
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

enum ConsultationStatus {
  DRAFT
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

enum ExecutionStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
  CACHED
}

enum TemplateVisibility {
  PRIVATE
  COMPANY
  GLOBAL
}

model Tenant {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  domain      String?
  branding    Json?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  companies   Company[]
  apiTokens   ApiToken[]
}

model ApiToken {
  id          String         @id @default(cuid())
  ownerType   TokenOwnerType
  tenantId    String?
  label       String
  tokenHash   String         @unique
  last4       String
  scopes      Json?
  isActive    Boolean        @default(true)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdById String?
  createdAt   DateTime       @default(now())

  tenant      Tenant?        @relation(fields: [tenantId], references: [id])
  createdBy   User?          @relation("api_tokens_created_by_user", fields: [createdById], references: [id])

  @@index([tenantId])
}

model Company {
  id            String        @id @default(cuid())
  tenantId      String?
  name          String
  slug          String        @unique
  document      String        @unique
  email         String?
  phone         String?
  metadata      Json?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant        Tenant?       @relation(fields: [tenantId], references: [id])
  users         User[]
  invites       Invite[]
  wallet        Wallet?
  templates     Template[]
  consultations Consultation[]
  ledgerEntries LedgerEntry[]

  @@index([tenantId])
}

model User {
  id              String      @id @default(cuid())
  companyId       String?
  fullName        String
  email           String      @unique
  document        String?     @unique
  phone           String?
  passwordHash    String
  role            Role        @default(USER)
  isActive        Boolean     @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  company         Company?    @relation(fields: [companyId], references: [id])
  invitesCreated  Invite[]    @relation("invites_created_by_user")
  templates       Template[]
  consultations   Consultation[]
  ledgerEntries    LedgerEntry[]
  providerTestLogs ProviderTestLog[]
  mergeLogs       MergeLog[]
  apiTokensCreated ApiToken[] @relation("api_tokens_created_by_user")

  @@index([companyId])
}

model Invite {
  id               String       @id @default(cuid())
  type             InviteType
  status           InviteStatus @default(PENDING)
  companyId        String?
  invitedByUserId  String?
  email            String
  document         String?
  roleToAssign     Role?
  tokenHash        String       @unique
  expiresAt        DateTime
  metadata         Json?
  acceptedAt       DateTime?
  createdAt        DateTime     @default(now())

  company          Company?     @relation(fields: [companyId], references: [id])
  invitedBy        User?        @relation("invites_created_by_user", fields: [invitedByUserId], references: [id])

  @@index([companyId])
}

model Wallet {
  id          String      @id @default(cuid())
  companyId   String      @unique
  balance     Decimal     @db.Decimal(14, 2) @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company     Company     @relation(fields: [companyId], references: [id])
  entries     LedgerEntry[]
}

model LedgerEntry {
  id              String         @id @default(cuid())
  walletId        String
  companyId       String?
  userId          String?
  consultationId  String?
  type            LedgerEntryType
  amount          Decimal        @db.Decimal(14, 2)
  balanceBefore   Decimal        @db.Decimal(14, 2)
  balanceAfter    Decimal        @db.Decimal(14, 2)
  description     String
  metadata        Json?
  createdAt       DateTime       @default(now())

  wallet          Wallet         @relation(fields: [walletId], references: [id])
  company         Company?       @relation(fields: [companyId], references: [id])
  user            User?          @relation(fields: [userId], references: [id])
  consultation    Consultation?  @relation(fields: [consultationId], references: [id])

  @@index([walletId])
  @@index([companyId])
  @@index([userId])
  @@index([consultationId])
}

model ConsultationType {
  id               String           @id @default(cuid())
  key              String           @unique
  name             String
  description      String?
  targetSectionKeys Json?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  products         ProviderProduct[]
}

model CanonicalFieldCatalog {
  id            String               @id @default(cuid())
  pathKey       String               @unique
  label         String
  dataType      String
  description   String?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  mappings      ProviderFieldMapping[]
}

model Provider {
  id             String             @id @default(cuid())
  name           String
  slug           String             @unique
  baseUrl        String
  authType       ProviderAuthType   @default(NONE)
  credentials    Json?
  defaultHeaders Json?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  operations     ProviderOperation[]
  products       ProviderProduct[]
  testLogs       ProviderTestLog[]
  executions     ConsultationExecution[]
}

model ProviderOperation {
  id              String                @id @default(cuid())
  providerId      String
  operationType   ProviderOperationType
  name            String
  path            String
  method          HttpMethod            @default(POST)
  headersTemplate Json?
  queryTemplate   Json?
  bodyTemplate    Json?
  timeoutMs       Int?
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  provider        Provider              @relation(fields: [providerId], references: [id])
  testLogs        ProviderTestLog[]

  @@index([providerId])
}

model ProviderProduct {
  id                 String                 @id @default(cuid())
  providerId         String
  consultationTypeId String?
  name               String
  code               String
  externalId         String?
  endpointPath       String
  method             HttpMethod             @default(POST)
  queryTemplate      Json?
  bodyTemplate       Json?
  headersTemplate    Json?
  timeoutMs          Int?
  cost               Decimal                @db.Decimal(14, 2)
  isActive           Boolean                @default(true)
  sampleRequest      Json?
  sampleResponse     Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  provider           Provider               @relation(fields: [providerId], references: [id])
  consultationType   ConsultationType?      @relation(fields: [consultationTypeId], references: [id])
  mappings           ProviderFieldMapping[]
  templateItems      TemplateItem[]
  consultationItems  ConsultationItem[]
  testLogs           ProviderTestLog[]
  executions         ConsultationExecution[]

  @@unique([providerId, code])
  @@index([providerId])
}

model ProviderFieldMapping {
  id                String                 @id @default(cuid())
  productId         String
  canonicalFieldId  String
  sourcePath        String
  transformName     String?
  fallbackValue     String?
  notes             String?
  sortOrder         Int                    @default(0)
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  product           ProviderProduct        @relation(fields: [productId], references: [id])
  canonicalField    CanonicalFieldCatalog  @relation(fields: [canonicalFieldId], references: [id])

  @@index([productId])
  @@index([canonicalFieldId])
}

model ProviderTestLog {
  id                String             @id @default(cuid())
  providerId        String
  productId         String?
  operationId       String?
  createdById       String?
  requestPayload    Json?
  responsePayload   Json?
  normalizedPayload Json?
  statusCode        Int?
  success           Boolean            @default(false)
  errorMessage      String?
  createdAt         DateTime           @default(now())

  provider          Provider           @relation(fields: [providerId], references: [id])
  product           ProviderProduct?   @relation(fields: [productId], references: [id])
  operation         ProviderOperation? @relation(fields: [operationId], references: [id])
  createdBy         User?              @relation(fields: [createdById], references: [id])

  @@index([providerId])
  @@index([productId])
  @@index([operationId])
}

model Template {
  id            String              @id @default(cuid())
  companyId     String?
  userId        String?
  name          String
  description   String?
  visibility    TemplateVisibility  @default(PRIVATE)
  isFavorite    Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  company       Company?            @relation(fields: [companyId], references: [id])
  user          User?               @relation(fields: [userId], references: [id])
  items         TemplateItem[]
  consultations Consultation[]

  @@index([companyId])
  @@index([userId])
}

model TemplateItem {
  id                String           @id @default(cuid())
  templateId        String
  providerProductId String
  sortOrder         Int              @default(0)
  alias             String?
  createdAt         DateTime         @default(now())

  template          Template         @relation(fields: [templateId], references: [id])
  providerProduct   ProviderProduct  @relation(fields: [providerProductId], references: [id])

  @@unique([templateId, providerProductId])
  @@index([providerProductId])
}

model Consultation {
  id                String              @id @default(cuid())
  companyId         String?
  requestedByUserId String
  templateId        String?
  subjectDocument   String
  subjectType       String
  totalCost         Decimal             @db.Decimal(14, 2) @default(0)
  status            ConsultationStatus  @default(DRAFT)
  mergedPayload     Json?
  renderPayload     Json?
  errorMessage      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  completedAt       DateTime?

  company           Company?            @relation(fields: [companyId], references: [id])
  requestedByUser   User                @relation(fields: [requestedByUserId], references: [id])
  template          Template?           @relation(fields: [templateId], references: [id])
  items             ConsultationItem[]
  executions        ConsultationExecution[]
  ledgerEntries     LedgerEntry[]
  mergeLogs         MergeLog[]

  @@index([companyId])
  @@index([requestedByUserId])
  @@index([templateId])
}

model ConsultationItem {
  id                String           @id @default(cuid())
  consultationId    String
  providerProductId String
  sortOrder         Int              @default(0)
  requestedCost     Decimal          @db.Decimal(14, 2)

  consultation      Consultation     @relation(fields: [consultationId], references: [id])
  providerProduct   ProviderProduct  @relation(fields: [providerProductId], references: [id])
  executions        ConsultationExecution[]

  @@index([consultationId])
  @@index([providerProductId])
}

model ConsultationExecution {
  id                 String            @id @default(cuid())
  consultationId     String
  consultationItemId String?
  providerId         String
  productId          String?
  status             ExecutionStatus   @default(PENDING)
  usedCache          Boolean           @default(false)
  requestPayload     Json?
  rawResponse        Json?
  normalizedPayload  Json?
  providerCost       Decimal?          @db.Decimal(14, 2)
  statusCode         Int?
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime          @default(now())

  consultation       Consultation      @relation(fields: [consultationId], references: [id])
  consultationItem   ConsultationItem? @relation(fields: [consultationItemId], references: [id])
  provider           Provider          @relation(fields: [providerId], references: [id])
  product            ProviderProduct?  @relation(fields: [productId], references: [id])

  @@index([consultationId])
  @@index([providerId])
  @@index([productId])
}

model MergeLog {
  id                 String         @id @default(cuid())
  consultationId     String?
  createdById        String?
  sourceReferenceIds String[]
  mergedPayload      Json
  strategy           String
  createdAt          DateTime       @default(now())

  consultation       Consultation?  @relation(fields: [consultationId], references: [id])
  createdBy          User?          @relation(fields: [createdById], references: [id])

  @@index([consultationId])
  @@index([createdById])
}
