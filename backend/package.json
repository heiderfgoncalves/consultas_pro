{
  "name": "consultas-pro-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend base para o Consultas PRO",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/src && cp -r src/public dist/src/",
    "start": "node dist/src/server.js",
    "worker": "tsx src/workers/consultation.worker.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "reset-user-password": "tsx prisma/reset-user-password.ts",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.71.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.6.1",
    "ioredis": "^5.4.1",
    "jsonpath-plus": "^10.3.0",
    "mustache": "^4.2.0",
    "pino": "^9.5.0",
    "puppeteer": "^25.1.0",
    "ulid": "^2.3.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
